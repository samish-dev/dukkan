generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         String    @default("customer")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  merchants Merchant[]
  orders    Order[]
}

model Merchant {
  id          Int       @id @default(autoincrement())
  name        String
  ownerUserId Int
  deletedAt   DateTime?

  owner    User      @relation(fields: [ownerUserId], references: [id])
  products Product[]
  orders   Order[]

  @@index([ownerUserId])
}

model Product {
  id          Int       @id @default(autoincrement())
  merchantId  Int
  name        String
  description String    @default("")
  priceCents  Int
  stock       Int       @default(0)
  deletedAt   DateTime?

  merchant Merchant    @relation(fields: [merchantId], references: [id])
  items    OrderItem[]

  @@index([merchantId])
}

model Order {
  id            Int       @id @default(autoincrement())
  customerId    Int
  merchantId    Int
  status        String    @default("pending")
  subtotalCents Int
  discountCents Int       @default(0)
  vatCents      Int
  totalCents    Int
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  customer User        @relation(fields: [customerId], references: [id])
  merchant Merchant    @relation(fields: [merchantId], references: [id])
  items    OrderItem[]

  @@index([merchantId, createdAt])
  @@index([customerId])
}

model OrderItem {
  id             Int @id @default(autoincrement())
  orderId        Int
  productId      Int
  quantity       Int
  unitPriceCents Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}
